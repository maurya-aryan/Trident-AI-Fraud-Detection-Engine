# ========================================
# TRIDENT AI Fraud Detection Engine
# Environment Variables Template
# ========================================

# --- Security & Authentication ---
TOKEN_MASTER_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- API Configuration ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
TRIDENT_API_URL=http://localhost:8000

# --- Database ---
DATABASE_URL=sqlite:///./trident_alerts.db

# --- IMAP Email Polling ---
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_INTERVAL=12
IMAP_MARK_SEEN=false
IMAP_PROCESSOR_FILE=processed_uids.txt

# --- External URLs ---
TRIDENT_URL=http://127.0.0.1:8000/detect
ALERTS_URL=http://127.0.0.1:8000/alerts

# --- AI Model Configuration ---
AI_TEXT_MODEL=roberta-base-openai-detector
AI_TEXT_FALLBACK=true

# --- ClamAV Antivirus ---
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_ENABLED=false

# --- Logging ---
LOG_LEVEL=INFO

# --- Demo/Testing ---
DEMO_TEST_PASSWORD=TestPassword123!
